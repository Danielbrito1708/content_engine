{
  "version": "2.0",
  "canvas": { "width": 1080, "supersample": 2 },
  "card": {
    "width": 880,
    "offset": { "x": 60, "y": 0 },
    "gap": 18
  },
  "background": {
    "color": [255, 255, 255, 255],
    "radius": 24,
    "padding": { "top": 32, "right": 32, "bottom": 32, "left": 32 },
    "shadow": {
      "enabled": true,
      "color": [0, 0, 0, 110],
      "blur": 16,
      "spread": 0,
      "offset": { "x": 0, "y": 10 }
    }
  },
  "assets": [
    {
      "id": "avatar",
      "minio_key": "assets/avatar.png",
      "size": { "width": 72, "height": 72 },
      "position": { "x": 0, "y": 0 }
    }
  ],
  "text": {
    "font_path": "assets/fonts/Arial-Black.ttf",
    "size": 36,
    "color": [0, 0, 0, 255],
    "offset": { "x": 0, "y": 0 },
    "line_spacing": 10
  }
}
