# ── blender_worker ───────────────────────────────────────────────
DEBUG=true
ENV=dev
ROOT_DIR=/home/user/content_engine/blender_worker   # local; no container use /app

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/blender_worker

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blender-jobs

# ── orchestrator ─────────────────────────────────────────────────
# ORCHESTRATOR_SECRET=

# ── tts_service ──────────────────────────────────────────────────
# TTS_MODEL=
# Velocidade da narração, em % sobre o ritmo natural da voz. Formato SSML
# (percentual com sinal): "+15%" acelera, "-10%" desacelera, "+0%" desliga.
# TTS_RATE=+15%

# ── llm_service ──────────────────────────────────────────────────
# LLM_API_KEY=
# LLM_MODEL=
# Modelo usado só para moderação (POST /moderate) — a chamada é um sim/não,
# então vale apontar para um modelo mais barato. Sem isso, usa LLM_MODEL.
# LLM_MODERATION_MODEL=

# ── content_scout ────────────────────────────────────────────────
# No API key needed — the Reddit RSS path is unauthenticated.
# SCOUT_ENABLED=true                              # false disables the periodic loop
# SCOUT_USER_AGENT=content_engine/0.1 (content_scout)
