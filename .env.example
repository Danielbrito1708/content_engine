# ── blender_worker ───────────────────────────────────────────────
DEBUG=true
ENV=dev
ROOT_DIR=/home/user/content_engine/blender_worker   # local; no container use /app

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/blender_worker

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blender-jobs

# ── orchestrator ─────────────────────────────────────────────────
# ORCHESTRATOR_SECRET=

# ── tts_service ──────────────────────────────────────────────────
# TTS_MODEL=

# ── llm_service ──────────────────────────────────────────────────
# LLM_API_KEY=
# LLM_MODEL=
