# ── blender_worker ───────────────────────────────────────────────
DEBUG=true
ENV=dev
ROOT_DIR=/home/user/content_engine/blender_worker   # local; no container use /app

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/blender_worker

# Em produção isto aponta para o R2, não para o MinIO local — o Buffer baixa o
# vídeo por URL pré-assinada e não alcança um endpoint na sua LAN:
#   MINIO_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blender-jobs

# ── orchestrator ─────────────────────────────────────────────────
# OBRIGATÓRIO: id do template registrado via POST /templates no blender_worker.
# Sem ele o orchestrador não sobe (leitura direta, não tem default).
BLENDER_TEMPLATE_ID=
# ORCHESTRATOR_SECRET=

# ── tts_service ──────────────────────────────────────────────────
# TTS_MODEL=
# Velocidade da narração, em % sobre o ritmo natural da voz. Formato SSML
# (percentual com sinal): "+15%" acelera, "-10%" desacelera, "+0%" desliga.
# Fallback: o valor efetivo vem do "narration.rate" do template.json. Este env
# var só vale para templates sem esse bloco ou chamadas diretas ao tts_service.
# TTS_RATE=+30%
#
# Provider: "edge" (grátis, travado em 24 kHz / 48 kbps), "azure" (mesmas vozes
# em 48 kHz / 192 kbps, exige conta e key) ou "elevenlabs" (stub).
#
# DECISÃO (14/08/2026): fica no "edge". O Azure está implementado e é melhor em
# áudio, mas custa uma conta a manter para uma diferença que não bloqueia
# publicação. Trocar é preencher as duas vars do Azure e apontar aqui — o serviço
# se recusa a subir se faltar alguma, então a troca falha limpo, não no meio de
# uma produção.
# TTS_PROVIDER=edge
#
# A voz sai do gênero de quem narra a história (o "narrator_gender" do refino).
# TTS_VOICE é só o fallback: história sem narrador identificável, ou chamada
# direta ao serviço sem o campo.
# TTS_VOICE=pt-BR-ThalitaNeural
# TTS_VOICE_MALE=pt-BR-AntonioNeural
# TTS_VOICE_FEMALE=pt-BR-FranciscaNeural
#
# Obrigatórios quando TTS_PROVIDER=azure. A key sai do recurso "Speech" no
# portal do Azure; a região é o slug do recurso (ex.: brazilsouth, eastus).
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=brazilsouth
# AZURE_OUTPUT_FORMAT=audio-48khz-192kbitrate-mono-mp3
#
# Pós-processamento do áudio (uma única passada de ffmpeg).
# NORMALIZE_AUDIO=true
# LOUDNESS_TARGET_LUFS=-16
#
# MAX_PAUSE_MS é um TETO, não um gatilho: é o silêncio que SOBRA em cada pausa.
# Pausas menores passam intactas; toda pausa maior sai com exatamente esse valor.
# O default antigo (500) deixava toda pausa longa em ~0,5s e era o que fazia a
# narração soar esburacada. MIN_SILENCE_MS ainda é aceito como alias depreciado.
# REMOVE_SILENCE=true
# SILENCE_THRESH_DB=-40
# MAX_PAUSE_MS=200
#
# Vazios = o arquivo de saída casa com o que o provider entregou. Só preencha
# para forçar, e nunca para cima do que a fonte tem: reamostrar não adiciona
# banda. No `edge`, forçar 48000/192k gerou arquivo 4x maior sem ganho nenhum.
# AUDIO_BITRATE=
# AUDIO_SAMPLE_RATE=

# ── llm_service ──────────────────────────────────────────────────
# LLM_API_KEY=
# LLM_MODEL=
# Modelo usado só para moderação (POST /moderate) — a chamada é um sim/não,
# então vale apontar para um modelo mais barato. Sem isso, usa LLM_MODEL.
# LLM_MODERATION_MODEL=
# Modelo usado só para avaliar gancho e storytelling (POST /story-quality). Julga
# ~30 aberturas numa chamada só e é julgamento de qualidade narrativa, não um
# sim/não — não convém compartilhar o modelo barato da moderação. Sem isso, usa
# LLM_MODEL.
# LLM_STORY_MODEL=

# ── tiktok_poster ────────────────────────────────────────────────
# OBRIGATÓRIOS: o serviço se recusa a subir sem os dois. O token sai de
# https://publish.buffer.com/developers/api; o profile é o id do perfil TikTok
# conectado no Buffer.
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID=
# Organização no Buffer. Opcional, mas **preencha**: sem ela o cliente descobre
# a organização a cada request, e isso é uma chamada a mais em cima de uma cota
# de 250 por dia. Pegar com:
#   query { account { organizations { id name } } }
# BUFFER_ORG_ID=
#
# Canal do YouTube no MESMO Buffer, para o vídeo sair nos dois lugares.
# OPCIONAL: vazio desliga o YouTube e o serviço segue publicando só no TikTok —
# um destino secundário não pode impedir o serviço de subir. Conecte o canal em
# publish.buffer.com e pegue o id na URL do canal.
# BUFFER_YOUTUBE_CHANNEL_ID=
#
# Host público do bucket, usado para montar a URL que o Buffer baixa. Em dev,
# vazio — e o agendamento não funciona de verdade, porque o Buffer não alcança o
# MinIO local. Em produção, o domínio r2.dev (ou o custom domain) do bucket.
# R2_PUBLIC_URL=

# ── monitoramento / notificação ──────────────────────────────────
# Avisos de operação no WhatsApp. Sem nenhuma das duas vars abaixo, tudo aqui
# é no-op: o código roda igual, só não manda mensagem. Nada disto pode derrubar
# um run — o notify engole a própria falha por construção.
#
# CallMeBot (grátis, sem cadastro). Setup, uma vez:
#   1. salve +34 644 51 95 23 nos contatos
#   2. mande "I allow callmebot to send me messages"
#   3. o bot responde com a APIKEY
# O telefone vai com código do país e sem sinais: 5511987654321
# CALLMEBOT_PHONE=
# CALLMEBOT_APIKEY=
#
# Destino alternativo/adicional: recebe POST {"text": "..."} . É por aqui que
# entram WAHA, ntfy, Discord ou Slack sem tocar em código. Os dois podem estar
# ligados ao mesmo tempo.
# NOTIFY_WEBHOOK_URL=
#
# Dead-man's switches (Healthchecks.io e compatíveis) — o inverso de um alerta:
# quem avisa é o SILÊNCIO destes pings, do lado de fora. É a única forma de
# detectar uma máquina que morreu sem conseguir reportar a própria morte.
#   ALIVE    — o orchestrador pinga a cada ciclo de manutenção (15 min).
#              Janela curta. Pega "o processo morreu".
#   SCOUT    — o scout pinga ao fim de cada ciclo (1h). Pega "a fila secou em
#              silêncio" enquanto o resto do sistema responde normalmente.
#   PRODUCED — pingado só quando um run é concluído de verdade. Janela LARGA
#              (24-36h): esta é a única que pega o caso em que todos os /health
#              respondem 200 e mesmo assim nenhum vídeo sai. Janela curta aqui
#              vira alarme falso todo fim de semana devagar.
# HEALTHCHECK_ALIVE_URL=
# HEALTHCHECK_SCOUT_URL=
# HEALTHCHECK_PRODUCED_URL=
#
# Fuso dos horários mostrados nas mensagens. Já tem default no compose.
# TZ=America/Sao_Paulo

# ── content_scout ────────────────────────────────────────────────
# No API key needed — the Reddit RSS path is unauthenticated.
# SCOUT_ENABLED=true                              # false disables the periodic loop
# SCOUT_USER_AGENT=content_engine/0.1 (content_scout)
