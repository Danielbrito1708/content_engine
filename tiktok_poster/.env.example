DEBUG=true
ENV=dev
ROOT_DIR=/home/user/content_engine/tiktok_poster   # local; no container use /app

# Buffer
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID=

# Storage — em dev aponta pro MinIO local, em prod aponta pro Cloudflare R2
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Produção (R2): descomente e preencha
# MINIO_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# MINIO_ACCESS_KEY=R2_ACCESS_KEY_ID
# MINIO_SECRET_KEY=R2_SECRET_ACCESS_KEY
