DEBUG=true
ENV=dev
ROOT_DIR=/home/user/content_engine/tts_service   # local; no container use /app

# Provider: "edge" | "elevenlabs"
TTS_PROVIDER=edge

# A voz de cada request vem do gênero do narrador (campo "narrator_gender").
# TTS_VOICE é o fallback de quem não manda o campo, ou de um narrador "unknown".
TTS_VOICE=pt-BR-ThalitaNeural
TTS_VOICE_MALE=pt-BR-AntonioNeural
TTS_VOICE_FEMALE=pt-BR-FranciscaNeural

# ElevenLabs (futuro)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
