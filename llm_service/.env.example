DEBUG=true
ENV=dev
ROOT_DIR=/home/user/content_engine/llm_service   # local; no container use /app

# Provider: "openrouter" | "anthropic" | "chutes"
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-3.5-sonnet

# OpenRouter
OPENROUTER_API_KEY=

# Anthropic (Claude Pro)
ANTHROPIC_API_KEY=

# Chutes AI
CHUTES_API_KEY=
CHUTES_BASE_URL=https://llm.chutes.ai/v1
